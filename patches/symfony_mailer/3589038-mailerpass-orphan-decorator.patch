+++ b/src/MailerPass.php
@@ -19,7 +19,16 @@ class MailerPass implements CompilerPassInterface {
     $mailer_services = [];
     foreach ($container->getDefinitions() as $service_id => $service_definition) {
       $class = $service_definition->getClass();
-      if ($class && class_exists($class) && isset(class_implements($class)[ComponentMailerInterface::class])) {
+      try {
+        $is_component_mailer = $class && class_exists($class) && isset(class_implements($class)[ComponentMailerInterface::class]);
+      }
+      catch (\Error) {
